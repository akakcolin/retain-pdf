{
  "name": "front-tailwind-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run prepare:vendor && npm run generate:version && npm run build:css && npm run build:js",
    "build:css": "node ./scripts/build-css.mjs && node ./scripts/stamp-cache-version.mjs",
    "build:js": "node ./scripts/build-js-bundle.mjs && node ./scripts/stamp-cache-version.mjs",
    "stamp:assets": "node ./scripts/stamp-cache-version.mjs",
    "generate:version": "node ./scripts/generate-app-version.mjs",
    "prepare:vendor": "node ./scripts/prepare-runtime-deps.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:any-budget": "node ./scripts/check-any-budget.mjs",
    "smoke:desktop-first-run": "node --import ./tests/helpers/register-jsx.mjs ./scripts/desktop-first-run-smoke.mjs",
    "smoke:homepage-actions": "python3 ./scripts/frontend-homepage-actions-smoke.py",
    "smoke:homepage": "python3 ./scripts/frontend-homepage-smoke.py",
    "smoke:mock-submit": "python3 ./scripts/frontend-mock-submit-smoke.py",
    "smoke:parallel-status": "python3 ./scripts/frontend-parallel-status-smoke.py",
    "smoke:status": "node ./scripts/frontend-status-smoke.mjs",
    "test": "node --import ./tests/helpers/register-jsx.mjs --test --test-force-exit tests/*.test.mjs",
    "watch:css": "node ./scripts/build-css.mjs --watch",
    "watch:js": "node ./scripts/build-js-bundle.mjs --watch",
    "visual:check": "node ./scripts/visual-check.mjs",
    "visual:update": "node ./scripts/visual-check.mjs --update"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.6",
    "mathjax-full": "^3.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-pdf": "^9.2.1",
    "react-resizable-panels": "4.12.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
