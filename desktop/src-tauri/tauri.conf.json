{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RetainPDF",
  "version": "4.1.7",
  "identifier": "com.wxyhgk.retainpdf",
  "mainBinaryName": "retainpdf-desktop",
  "build": {
    "beforeBuildCommand": "npm run prepare-app && npm run prepare-tauri",
    "frontendDist": "../app/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "RetainPDF",
        "url": "splash.html",
        "width": 520,
        "height": 360,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "visible": true,
        "skipTaskbar": true,
        "backgroundColor": "#f5f5f7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:41000 http://127.0.0.1:42000; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "deb"
    ],
    "icon": [
      "../build/icon.icns",
      "../build/icon.png",
      "../build/icon.ico",
      "../build/icons/32x32.png",
      "../build/icons/128x128.png",
      "../build/icons/256x256.png"
    ],
    "resources": {
      "../app/backend": "backend"
    },
    "category": "Productivity",
    "shortDescription": "RetainPDF layout-preserving PDF translation",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {}
    },
    "linux": {
      "deb": {}
    }
  }
}
